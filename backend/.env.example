# LLM API 统一可插拔配置 (支持 火山方舟 / DeepSeek / 阿里通义 / OpenAI)
# 默认配置为火山方舟 Ark (与原项目兼容) 或 DeepSeek
LLM_PROVIDER=volcano_ark
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=ep-2025xxxxxx-xxxxx
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=30.0

# 本地服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DB_PATH=./data/ecommerce_cs.db
CACHE_DIR=./data/cache

